# Use npm run setup for a self-contained portable PostgreSQL demo.
# Or provide PostgreSQL and generate your own secrets (no default passwords).
DATABASE_URL=postgresql://testigo:CHANGE_ME@127.0.0.1:5432/testigo
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PORT=4310
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4310
COOKIE_SECURE=false
# Set to true only behind an HTTPS proxy you control; see docs/security.md.
TRUST_PROXY=false
RETENTION_DAYS=30
